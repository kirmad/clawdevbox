# Dependencies
node_modules/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Playwright + Chromium
test-results/
playwright-report/
playwright/.cache/

# Verification artifacts (regenerated by verify-*.mjs)
verify-screenshots/

# Per-run clawdevbox state
.clawdevbox/
clawdevbox-workspaces/

# Git worktrees (isolated feature workspaces)
.worktrees/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# pnpm / yarn / npm cache
.pnpm-store/
.yarn/
.npm/

# Dev-mode junctions created by 'clawdevbox plugin install <local-folder>'.
# Each plugin with executable code gets a node_modules junction to the host's
# node_modules so its tool .ts files can resolve their bare-name imports. Don't
# commit these.
plugins/*/node_modules


# Runtime artifacts (per-session outputs)
/artifacts/
# Playwright screenshots from ad-hoc validation
/files/

samples/triggers/teams-listener.mjs

# Brainstorming visual-companion runtime state (per-session, ephemeral)
.superpowers/

# Spike per-run artifact stores (regenerable test data; spike code is tracked)
spikes/*/.store/

# Stray debug dumps / rotated logs (never track — leaked local paths & internal data)
mcp-server/mcp-*.txt
*.log.prev
_validate/results.json
_validate/__pycache__/
# Ad-hoc test/dev screenshots (may embed internal env/PR data — keep out of git)
mcp-server/*.png
