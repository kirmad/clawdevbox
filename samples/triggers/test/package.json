{
  "name": "conductor-trigger-test-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end test harness for Conductor trigger scripts against real Azure DevOps. Mocks only the Conductor side.",
  "scripts": {
    "mock": "tsx mock-conductor.ts",
